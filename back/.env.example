# Desenvolvimento local: lances fictícios para validar a interface
A4_MODO_DEMO=true
A4_INTERVALO_S=6

# Integração real com Kafka/P7 (desative o modo demo ao habilitar)
A4_KAFKA_ENABLED=false
# sem endereco padrao: escolha o broker (com o Kafka ligado e sem ele, o back sobe sem barramento)
# A4_KAFKA_BOOTSTRAP_SERVERS=localhost:9092         # docker compose up -d na raiz do a4
# A4_KAFKA_BOOTSTRAP_SERVERS=172.18.4.56:9092       # Kafka da Jetson, so na rede do DCOMP
# grupo do consumidor: padrao e um por instancia (A4-<aleatorio>), para dois backs nao dividirem as mensagens
# A4_KAFKA_GROUP_ID=A4-score-manager

# Token do arbitro: com ele, as rotas que alteram o jogo ou movem a camera exigem
# Authorization: Bearer <token> (o front pede uma vez). Sem ele, a API fica aberta.
# A4_TOKEN=troque-este-valor

# Onde as partidas ficam salvas (o back que reinicia continua o jogo); padrao back/dados
# A4_DADOS_DIR=dados

# Integração S1: com Kafka habilitado, o A4 consome ods.s1.position e
# ods.i3.calibration automaticamente para alimentar o Detector de quiques.
# Não é necessário configurar nada além de habilitar o Kafka.

# Zonas: onde os artefatos ZONES ficam e quanto o desenho pode errar antes do aviso
A4_ARTEFATOS_DIR=artefatos
A4_ZONA_TOLERANCIA_CM=30
# Mensagem ods.i3.calibration em arquivo, para ter calibração sem esperar o tópico
# A4_CALIBRACAO_ARQUIVO=calibracao.json

# Gravação que o player toca (padrão: old/yolo/clipe.mp4); com o barramento, a mesma da câmera
# A4_P6_VIDEO=../old/dados/video.mp4
# Base para abrir o media_uri dos clipes do S4 (s4://<caminho> -> base/<caminho>)
# A4_S4_MEDIA_URL=http://s4/midia
# Mecanismo pan-tilt do A4 no ods.p7.move.command
# A4_P7_SOURCE_ID=pt0
