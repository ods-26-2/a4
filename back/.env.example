# Desenvolvimento local: lances fictícios para validar a interface
A4_MODO_DEMO=true
A4_INTERVALO_S=6

# Integração real com Kafka/P7 (desative o modo demo ao habilitar)
A4_KAFKA_ENABLED=false
A4_KAFKA_BOOTSTRAP_SERVERS=34.66.235.91:9093
A4_KAFKA_GROUP_ID=A4-score-manager
A4_KAFKA_TOPIC_REGRA=ods.regra.evento_consolidado

# Integração S1: com Kafka habilitado, o A4 consome ods.s1.position e
# ods.i3.calibration automaticamente para alimentar o Detector de quiques.
# Não é necessário configurar nada além de habilitar o Kafka.

# Zonas: onde os artefatos ZONES ficam e quanto o desenho pode errar antes do aviso
A4_ARTEFATOS_DIR=artefatos
A4_ZONA_TOLERANCIA_CM=30
# Mensagem ods.i3.calibration em arquivo, para ter calibração sem esperar o tópico
# A4_CALIBRACAO_ARQUIVO=calibracao.json

# Pseudo-P6: gravação que o player do A4 toca no lugar do P6 (padrão: old/yolo/clipe.mp4)
# A4_P6_VIDEO=../old/dados/video.mp4
